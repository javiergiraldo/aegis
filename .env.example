# Configuración del Entorno Aegis
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base de Datos PostgreSQL
DB_USER=aegis_admin
DB_PASSWORD=secure_password_demo_123
DB_NAME=aegis_db
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# API y Seguridad
SECRET_KEY=demo_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Integración DNS y Certificados
CERT_DNS_PROVIDER=cloudflare
CERT_DNS_TOKEN=demo_dns_token_12345
DOMAIN_ROOT=empresa-demo.com

# Gateway / Envoy Proxy
ENVOY_ADMIN_PORT=9901
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
